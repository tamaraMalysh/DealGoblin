TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
OWNER_CHAT_ID=
SOURCE_CHAT_IDS=

# Optional runtime settings
# Never copy production SQLite or Telethon session files into local development.
# If you need a local manual runtime, prefer:
# DB_PATH=data/local/dealgoblin.sqlite3
# SESSION_PATH=data/local/telethon.session
# RUNTIME_LOCK_PATH=data/local/runtime.lock
DB_PATH=data/dealgoblin.sqlite3
DB_BUSY_TIMEOUT_MS=15000
SESSION_PATH=data/telethon.session
SOURCE_BACKFILL_LIMIT=100
FORWARD_ALL_INGESTED=false
TELETHON_CONNECTION_RETRIES=-1
TELETHON_RETRY_DELAY_SECONDS=1.0
RUNTIME_RESTART_BASE_DELAY_SECONDS=3.0
RUNTIME_RESTART_MAX_DELAY_SECONDS=30.0
RUNTIME_LOCK_PATH=data/runtime.lock
BOT_HEALTHCHECK_INTERVAL_SECONDS=15.0
BOT_HEALTHCHECK_FAILURE_THRESHOLD=8
DUPLICATE_SUPPRESSION_DAYS=14
